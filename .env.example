# Temporal Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default

# Database Configuration
DATABASE_URL=postgresql://app_user:app_password@localhost:5433/orders

# Task Queues
ORDER_TASK_QUEUE=order-processing
SHIPPING_TASK_QUEUE=shipping-processing

# Timeouts (seconds)
WORKFLOW_TIMEOUT=15
MANUAL_REVIEW_TIMEOUT=10
ACTIVITY_TIMEOUT=5

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
INITIAL_RETRY_INTERVAL=1
MAX_RETRY_INTERVAL=10
BACKOFF_COEFFICIENT=2.0
